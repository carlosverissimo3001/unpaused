generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AvatarSource {
  SPOTIFY
  CUSTOM
}

model User {
  id                    String       @id @default(uuid())
  spotifyUserId         String       @unique @map("spotify_user_id")
  displayName           String       @map("display_name")
  avatarUrl             String?      @map("avatar_url")
  customAvatarUrl       String?      @map("custom_avatar_url")
  avatarSource          AvatarSource @default(SPOTIFY) @map("avatar_source")
  encryptedRefreshToken String?      @map("encrypted_refresh_token")
  country               String?      @map("country")

  isTrusted Boolean @default(false) @map("is_trusted")
  isAdmin   Boolean @default(false) @map("is_admin")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Streak freeze fields
  streakFreezes       Int      @default(0) @map("streak_freezes")
  answeredQuestionIds String[] @default([]) @map("answered_question_ids")

  stats        Stats[]
  gameSessions GameSession[]

  streakFreezeUsages StreakFreezeUsage[]

  hostedRooms MultiplayerRoom[] @relation("hostedRooms")
  roomPlayers RoomPlayer[]

  preferences  UserPreference?
  gauntletRuns GauntletRun[]

  @@map("users")
}

enum GameStatus {
  PLAYING
  WON
  LOST
  ABANDONED
}

model GameSession {
  id String @id @default(uuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  playlistId String   @map("playlist_id")
  mode       GameMode @default(ALL)

  trackId String @map("track_id")
  track   Track  @relation(fields: [trackId], references: [id])

  currentRound Int        @default(0) @map("current_round")
  guesses      Json       @default("[]")
  status       GameStatus @default(PLAYING)

  multiplayerRoomId String?          @map("multiplayer_room_id")
  multiplayerRoom   MultiplayerRoom? @relation(fields: [multiplayerRoomId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  @@index([userId])
  @@index([userId, mode])
  @@index([userId, createdAt])
  @@index([multiplayerRoomId])
  @@map("game_sessions")
}

model Track {
  id            String   @id
  name          String
  artistName    String   @map("artist_name")
  albumImageUrl String?  @map("album_image_url")
  albumName     String?  @map("album_name")
  albumUrl      String?  @map("album_url")
  releaseYear   Int?     @map("release_year")
  isrc          String?  @map("isrc")
  previewUrl    String?  @map("preview_url")
  previewRef    String?  @map("preview_ref")
  allArtists    String[] @default([]) @map("all_artists")
  metadata      Json?    @default("{}") @map("metadata")

  lastScrapedAt DateTime @default(now()) @map("last_scraped_at")
  createdAt     DateTime @default(now()) @map("created_at")

  // Need the default since I added this field after the table already had data
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  gameSessions GameSession[]
  gauntletRuns GauntletRun[]

  @@index([isrc])
  @@map("tracks")
}

/// Which tracks a guest round may draw from. Deliberately thin: the track data
/// itself lives in `tracks`, so there is one notion of a track. This table only
/// answers "may this be picked, and how well known is it".
model PoolTrack {
  /// Namespaced, matching tracks.id — "dz:908604612" for a Deezer-sourced track.
  id   String @id
  /// Unique here, unlike on tracks: it is what keeps one song out of the pool
  /// twice when it charts either side of a new year.
  isrc String @unique

  /// The year the song broke, not every year it charted.
  year Int
  /// Popularity of the song across every upload of it, not of the one recording
  /// we picked — a remaster and its clean upload differ by orders of magnitude.
  fame Int

  refreshedAt DateTime @default(now()) @map("refreshed_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([fame])
  @@index([year])
  @@map("pool_tracks")
}

/// Chart metadata for the public demo. Written by the same daily refresh that
/// writes the tracks, so covers follow Spotify when it rotates them.
model DemoPlaylist {
  slug        String  @id
  name        String
  imageUrl    String  @map("image_url")
  description String?

  fetchedAt DateTime @default(now()) @map("fetched_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("demo_playlists")
}

/// Chart tracks for the public demo used by carlosverissimo.com.
/// Refreshed daily by a scheduled job, so the request path never touches
/// Spotify and the last successful fetch survives an outage.
model DemoTrack {
  /// Spotify track id. Not unique on its own: charts overlap heavily, and the
  /// same track legitimately appears in several of them.
  id            String
  playlistSlug  String @map("playlist_slug")
  name          String
  artistName    String @map("artist_name")
  albumImageUrl String @map("album_image_url")
  previewUrl    String @map("preview_url")
  position      Int

  fetchedAt DateTime @default(now()) @map("fetched_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@id([playlistSlug, id])
  @@index([playlistSlug])
  @@map("demo_tracks")
}

enum GameMode {
  DAILY
  ALL
  MULTIPLAYER
  GAUNTLET
}

enum GauntletRunStatus {
  PLAYING
  ENDED
}

enum GauntletEndReason {
  WRONG_GUESS
  SKIP
  QUIT
}

enum GauntletDifficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

model GauntletRun {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  score      Int                 @default(0)
  status     GauntletRunStatus   @default(PLAYING)
  endReason  GauntletEndReason?  @map("end_reason")
  difficulty GauntletDifficulty

  trackIds String[] @default([]) @map("track_ids")

  currentTrackId String? @map("current_track_id")
  currentTrack   Track?  @relation(fields: [currentTrackId], references: [id])

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([userId, score])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("gauntlet_runs")
}

model Stats {
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  currentStreak Int       @default(0) @map("current_streak")
  bestStreak    Int       @default(0) @map("best_streak")
  lastWinDate   DateTime? @map("last_win_date")

  totalGames        Int      @default(0) @map("total_games")
  totalWins         Int      @default(0) @map("total_wins")
  roundDistribution Int[]    @default([0, 0, 0, 0, 0, 0, 0]) @map("score_distribution")
  mode              GameMode @default(ALL) @map("mode")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([userId, mode])
  @@map("stats")
}

model StreakQuizQuestion {
  id                 String   @id @default(uuid())
  question           String
  options            String[]
  correctAnswerIndex Int      @map("correct_answer_index")
  category           String   @default("general")
  context            String?
  isActive           Boolean  @default(true) @map("is_active")
  addedBy            String   @map("added_by")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("streak_quiz_questions")
}

model StreakFreezeUsage {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  freezesUsed  Int      @map("freezes_used")
  gapDays      Int      @map("gap_days")
  streakAtTime Int      @map("streak_at_time")
  coveredFrom  DateTime @map("covered_from")
  coveredTo    DateTime @map("covered_to")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("streak_freeze_usages")
}

enum RoomStatus {
  WAITING
  PLAYING
  COMPLETED
  EXPIRED
}

model MultiplayerRoom {
  id         String @id @default(uuid())
  inviteCode String @unique @map("invite_code")
  hostId     String @map("host_id")
  host       User   @relation("hostedRooms", fields: [hostId], references: [id], onDelete: Cascade)

  roundCount Int        @map("round_count")
  status     RoomStatus @default(WAITING)

  trackIds String[] @default([]) @map("track_ids")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  players      RoomPlayer[]
  gameSessions GameSession[]

  @@index([hostId])
  @@map("multiplayer_rooms")
}

model UserPreference {
  userId                  String   @id @map("user_id")
  showAlbumHint           Boolean  @default(true) @map("show_album_hint")
  showTextHints           Boolean  @default(true) @map("show_text_hints")
  reducedMotion           Boolean  @default(false) @map("reduced_motion")
  showGuessHistory        Boolean  @default(true) @map("show_guess_history")
  dailyChallengePlaylists String[] @default([]) @map("daily_challenge_playlists")
  timezone                String   @default("UTC") @map("timezone")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model RoomPlayer {
  id     String          @id @default(uuid())
  roomId String          @map("room_id")
  room   MultiplayerRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId String          @map("user_id")
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  isReady    Boolean  @default(false) @map("is_ready")
  totalScore Int      @default(0) @map("total_score")
  joinedAt   DateTime @default(now()) @map("joined_at")

  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@map("room_players")
}
