{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    ".next",
    "out",
    ".turbo",
    "frontend/sdk",
    "swagger-spec.json",
    "backend/prisma/migrations",
    "pnpm-lock.yaml",
    "**/*.css",
    "backend/src/pool",
    "frontend/next-env.d.ts"
  ]
}
