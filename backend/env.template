# Database
DATABASE_URL="postgresql://unpaused:unpaused_dev@localhost:5432/unpaused?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Spotify OAuth
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_REDIRECT_URI="http://localhost:3001/auth/callback"

# Spotify Client Credentials (app-only auth for guest play - search/catalog
# calls that don't need a user login). Different from the PKCE flow above:
# this one needs a secret. Get both from the same Spotify Developer Dashboard app.
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"

# Session
SESSION_SECRET="your-session-secret-min-32-chars-long"
SESSION_MAX_AGE_SECONDS=604800

# Encrypts Spotify refresh tokens at rest (AES-256-GCM). Required.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY="64-character-hex-string"

# CORS
# Origins allowed to call the public /demo endpoints, comma separated.
# These get CORS without credentials; leaving it unset blocks the portfolio.
PORTFOLIO_URL=

FRONTEND_URL="http://localhost:3000"

# Optional
APP_URL="http://localhost:3000"
LAST_FM_API_KEY=""
