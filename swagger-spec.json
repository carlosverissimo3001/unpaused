{
  "openapi": "3.0.0",
  "paths": {
    "/auth/login": {
      "get": {
        "operationId": "AuthController_login",
        "parameters": [],
        "responses": {
          "302": {
            "description": "Redirects to Spotify authorization"
          }
        },
        "summary": "Start Spotify OAuth flow",
        "tags": [
          "Api"
        ]
      }
    },
    "/auth/callback": {
      "get": {
        "operationId": "AuthController_callback",
        "parameters": [
          {
            "name": "code",
            "required": true,
            "in": "query",
            "description": "Authorization code from Spotify",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "required": true,
            "in": "query",
            "description": "State parameter for CSRF protection",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "required": false,
            "in": "query",
            "description": "Error message if authorization failed.",
            "schema": {
              "$ref": "#/components/schemas/Object"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to frontend after auth"
          }
        },
        "summary": "Handle Spotify OAuth callback",
        "tags": [
          "Api"
        ]
      }
    },
