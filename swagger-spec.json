{
  "openapi": "3.0.0",
  "paths": {
    "/auth/login": {
      "get": {
        "operationId": "login",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          },
          "302": {
            "description": "Redirects to Spotify authorization"
          }
        },
        "summary": "Start Spotify OAuth flow",
        "tags": [
          "Api"
        ]
      }
    },
    "/auth/callback": {
      "get": {
        "operationId": "callback",
        "parameters": [
          {
            "name": "code",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          },
          "302": {
            "description": "Redirects to frontend after auth"
          }
        },
        "summary": "Handle Spotify OAuth callback",
        "tags": [
          "Api"
        ]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthMeResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Get current authenticated user",
        "tags": [
          "Api"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successfully logged out"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Logout and clear session",
        "tags": [
          "Api"
        ]
      }
    },
    "/auth/token-login": {
      "post": {
        "description": "Use this when you have a Spotify access token but can't use OAuth flow. The token is validated by fetching your Spotify profile.",
        "operationId": "tokenLogin",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenLoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully logged in"
          },
          "201": {
            "description": ""
          },
          "401": {
            "description": "Invalid token"
          },
          "403": {
            "description": "Not available in production"
          }
        },
        "summary": "Dev-only: Login with a manually obtained Spotify token",
        "tags": [
          "Api"
        ]
      }
    },
    "/playlists/me": {
      "get": {
        "operationId": "getMyPlaylists",
        "parameters": [
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "example": 20,
              "type": "number"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "example": 0,
              "type": "number"
            }
          },
          {
            "name": "includePrivate",
            "required": false,
            "in": "query",
            "schema": {
              "default": false,
              "example": false,
              "type": "boolean"
            }
          },
          {
            "name": "onlyUserOwned",
            "required": false,
            "in": "query",
            "schema": {
              "default": false,
              "example": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaylistsResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Get current user's playlists",
        "tags": [
          "Api"
        ]
      }
    },
    "/playlists/{id}": {
      "get": {
        "operationId": "getPlaylistById",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaylistDto"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          },
          "404": {
            "description": "Playlist not found"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Get playlist by ID",
        "tags": [
          "Api"
        ]
      }
    },
    "/game/start": {
      "post": {
        "operationId": "startGame",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartGameDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameStateDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Start a new game from a playlist",
        "tags": [
          "Api"
        ]
      }
    },
    "/game/{id}": {
      "get": {
        "operationId": "getGameState",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "The internal Game Session UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameStateDto"
                }
              }
            }
          }
        },
        "summary": "Get current game state",
        "tags": [
          "Api"
        ]
      }
    },
    "/game/{id}/guess": {
      "post": {
        "operationId": "submitGuess",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "The internal Game Session UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GuessDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuessResultDto"
                }
              }
            }
          },
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuessResultDto"
                }
              }
            }
          }
        },
        "summary": "Submit a guess for a specific session",
        "tags": [
          "Api"
        ]
      }
    },
    "/search/tracks": {
      "get": {
        "operationId": "searchTracks",
        "parameters": [
          {
            "name": "q",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Track options",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TrackOptionDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Search Spotify tracks (for game guess options)",
        "tags": [
          "Api"
        ]
      }
    }
  },
  "info": {
    "title": "Unpaused Spotify API",
    "description": "The backend for the Spotify guessing game",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "unpaused_session"
      }
    },
    "schemas": {
      "AuthMeResponseDto": {
        "type": "object",
        "properties": {
          "spotifyUserId": {
            "type": "string",
            "example": "spotify_user_123"
          },
          "displayName": {
            "type": "string",
            "example": "John Doe"
          },
          "isTrusted": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "spotifyUserId",
          "displayName",
          "isTrusted"
        ]
      },
      "TokenLoginDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Spotify access token"
          },
          "refreshToken": {
            "type": "string",
            "description": "Spotify refresh token (optional)"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "PlaylistDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The ID of the playlist"
          },
          "name": {
            "type": "string",
            "description": "The name of the playlist"
          },
          "description": {
            "type": "string",
            "description": "The description of the playlist",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "description": "The image URL of the playlist"
          },
          "owner": {
            "type": "string",
            "description": "The owner of the playlist"
          },
          "totalTracks": {
            "type": "number",
            "description": "The total number of tracks in the playlist"
          },
          "isPublic": {
            "type": "boolean",
            "description": "Whether the playlist is public"
          },
          "externalUrl": {
            "type": "string",
            "description": "The external URL of the playlist"
          }
        },
        "required": [
          "id",
          "name",
          "imageUrl",
          "owner",
          "totalTracks",
          "isPublic",
          "externalUrl"
        ]
      },
      "PlaylistsResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "description": "The playlists",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlaylistDto"
            }
          },
          "total": {
            "type": "number",
            "description": "The total number of playlists"
          },
          "limit": {
            "type": "number",
            "description": "The limit of the playlists"
          },
          "offset": {
            "type": "number",
            "description": "The offset of the playlists"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ]
      },
      "StartGameDto": {
        "type": "object",
        "properties": {
          "playlistId": {
            "type": "string",
            "description": "The ID of the playlist to start the game with"
          }
        },
        "required": [
          "playlistId"
        ]
      },
      "GuessHistoryDto": {
        "type": "object",
        "properties": {
          "trackId": {
            "type": "string",
            "description": "The ID of the track"
          },
          "trackName": {
            "type": "string",
            "description": "The name of the track"
          },
          "artistName": {
            "type": "string",
            "description": "The artist of the track"
          },
          "result": {
            "enum": [
              "CORRECT",
              "ARTIST",
              "ALBUM",
              "WRONG",
              "SKIP",
              "ARTIST_AND_ALBUM"
            ],
            "type": "string",
            "description": "The result of the guess"
          }
        },
        "required": [
          "result"
        ]
      },
      "TrackOptionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The ID of the track"
          },
          "name": {
            "type": "string",
            "description": "The name of the track"
          },
          "normalizedName": {
            "type": "string",
            "description": "Normalized name for search/matching"
          },
          "artist": {
            "type": "string",
            "description": "The artist of the track"
          },
          "normalizedArtist": {
            "type": "string",
            "description": "Normalized artist for search/matching"
          },
          "albumImageUrl": {
            "type": "string",
            "description": "The album image URL of the track"
          },
          "albumName": {
            "type": "string",
            "description": "The album name of the track"
          },
          "albumUrl": {
            "type": "string",
            "description": "The album URL of the track"
          },
          "releaseYear": {
            "type": "number",
            "description": "The release year of the track"
          }
        },
        "required": [
          "id",
          "name",
          "normalizedName",
          "artist",
          "normalizedArtist"
        ]
      },
      "GameStateDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "The ID of the game session"
          },
          "currentRound": {
            "type": "number",
            "description": "The current round of the game"
          },
          "snippetDuration": {
            "type": "number",
            "description": "The duration of the current snippet"
          },
          "status": {
            "type": "string",
            "description": "The status of the game",
            "enum": [
              "PLAYING",
              "WON",
              "LOST"
            ]
          },
          "guesses": {
            "description": "The guesses of the game",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuessHistoryDto"
            }
          },
          "previewUrl": {
            "type": "string",
            "description": "The preview URL of the current track"
          },
          "answer": {
            "description": "The answer to the current track",
            "allOf": [
              {
                "$ref": "#/components/schemas/TrackOptionDto"
              }
            ]
          }
        },
        "required": [
          "sessionId",
          "currentRound",
          "snippetDuration",
          "status",
          "guesses"
        ]
      },
      "GuessDto": {
        "type": "object",
        "properties": {
          "trackId": {
            "type": "string",
            "description": "The ID of the track to guess"
          },
          "skip": {
            "type": "boolean",
            "default": false,
            "description": "Whether the current guess is a skip"
          },
          "trackName": {
            "type": "string",
            "description": "Track name"
          },
          "artistName": {
            "type": "string",
            "description": "Artist name"
          },
          "albumName": {
            "type": "string",
            "description": "Album name"
          }
        }
      },
      "GuessResultDto": {
        "type": "object",
        "properties": {
          "result": {
            "enum": [
              "CORRECT",
              "ARTIST",
              "ALBUM",
              "WRONG",
              "SKIP",
              "ARTIST_AND_ALBUM"
            ],
            "type": "string",
            "description": "The result of the guess"
          },
          "gameOver": {
            "type": "boolean",
            "description": "Whether the game is over"
          },
          "status": {
            "type": "string",
            "description": "The status of the game",
            "enum": [
              "PLAYING",
              "WON",
              "LOST"
            ]
          },
          "currentRound": {
            "type": "number",
            "description": "The current round of the game"
          },
          "snippetDuration": {
            "type": "number",
            "description": "The duration of the current snippet"
          }
        },
        "required": [
          "result",
          "gameOver",
          "status",
          "currentRound",
          "snippetDuration"
        ]
      }
    }
  }
}