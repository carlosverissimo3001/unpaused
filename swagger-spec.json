          "Api"
        ]
      }
    },
    "/game/share/{id}": {
      "get": {
        "operationId": "GameController_getShare",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Game session ID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
