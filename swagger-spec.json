  "info": {
    "title": "Unpaused Spotify API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "unpaused_session"
      }
    },
    "schemas": {
      "Object": {
        "type": "object",
        "properties": {}
      },
      "AuthMeResponseDto": {
        "type": "object",
        "properties": {
          "spotifyUserId": {
            "type": "string",
            "example": "spotify_user_123"
          },
          "displayName": {
            "type": "string",
            "example": "John Doe"
          },
          "isTrusted": {
            "type": "boolean",
            "example": false
          },
          "isAdmin": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "spotifyUserId",
          "displayName",
          "isTrusted",
          "isAdmin"
        ]
      },
      "TokenLoginDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Spotify access token"
          },
          "refreshToken": {
            "type": "string",
            "description": "Spotify refresh token (optional)"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "PlaylistDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The ID of the playlist"
          },
          "name": {
            "type": "string",
            "description": "The name of the playlist"
          },
          "description": {
            "type": "string",
            "description": "The description of the playlist",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "description": "The image URL of the playlist"
          },
          "owner": {
            "type": "string",
            "description": "The owner of the playlist"
          },
          "totalTracks": {
            "type": "number",
            "description": "The total number of tracks in the playlist"
          },
          "isPublic": {
            "type": "boolean",
            "description": "Whether the playlist is public"
          },
          "externalUrl": {
            "type": "string",
            "description": "The external URL of the playlist"
          }
        },
        "required": [
          "id",
          "name",
          "imageUrl",
          "owner",
          "totalTracks",
          "isPublic",
          "externalUrl"
        ]
      },
      "PlaylistsResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "description": "The playlists",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlaylistDto"
            }
          },
          "total": {
            "type": "number",
            "description": "The total number of playlists"
          },
          "limit": {
            "type": "number",
            "description": "The limit of the playlists"
          },
          "offset": {
            "type": "number",
            "description": "The offset of the playlists"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ]
      },
      "StartGameDto": {
        "type": "object",
        "properties": {
          "playlistId": {
            "type": "string",
            "description": "The ID of the playlist to start the game with"
          },
          "mode": {
            "type": "string",
            "description": "The game mode to start (all or daily)",
            "enum": [
              "DAILY",
              "ALL"
            ]
          }
        },
        "required": [
          "mode"
        ]
      },
      "GuessHistoryDto": {
        "type": "object",
        "properties": {
          "trackId": {
            "type": "string",
            "description": "The ID of the track"
          },
          "trackName": {
            "type": "string",
