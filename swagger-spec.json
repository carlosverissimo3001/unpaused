  "info": {
    "title": "Unpaused Spotify API",
    "description": "",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "unpaused_session"
      }
    },
    "schemas": {
      "AuthMeResponseDto": {
        "type": "object",
        "properties": {
          "spotifyUserId": {
            "type": "string",
            "example": "spotify_user_123"
          },
          "displayName": {
            "type": "string",
            "example": "John Doe"
          },
          "isTrusted": {
            "type": "boolean",
            "example": false
          },
          "isAdmin": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "spotifyUserId",
          "displayName",
          "isTrusted",
          "isAdmin"
        ]
      },
      "TokenLoginDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Spotify access token"
          },
          "refreshToken": {
            "type": "string",
            "description": "Spotify refresh token (optional)"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "PlaylistDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The ID of the playlist"
          },
          "name": {
            "type": "string",
            "description": "The name of the playlist"
          },
          "description": {
            "type": "string",
            "description": "The description of the playlist",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "description": "The image URL of the playlist"
          },
          "owner": {
            "type": "string",
            "description": "The owner of the playlist"
          },
          "totalTracks": {
            "type": "number",
            "description": "The total number of tracks in the playlist"
          },
          "isPublic": {
            "type": "boolean",
            "description": "Whether the playlist is public"
          },
          "externalUrl": {
            "type": "string",
            "description": "The external URL of the playlist"
          }
        },
        "required": [
          "id",
          "name",
          "imageUrl",
          "owner",
          "totalTracks",
          "isPublic",
          "externalUrl"
        ]
      },
      "PlaylistsResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "description": "The playlists",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlaylistDto"
            }
          },
          "total": {
            "type": "number",
            "description": "The total number of playlists"
          },
          "limit": {
            "type": "number",
            "description": "The limit of the playlists"
          },
          "offset": {
            "type": "number",
            "description": "The offset of the playlists"
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ]
      },
      "StartGameDto": {
        "type": "object",
        "properties": {
          "playlistId": {
            "type": "string",
            "description": "The ID of the playlist to start the game with"
          },
          "mode": {
            "type": "string",
            "description": "The game mode to start (all or daily)",
            "enum": [
              "DAILY",
              "ALL"
            ]
          }
        },
        "required": [
          "mode"
        ]
      },
      "GuessHistoryDto": {
        "type": "object",
        "properties": {
          "trackId": {
            "type": "string",
            "description": "The ID of the track"
          },
          "trackName": {
            "type": "string",
            "description": "The name of the track"
          },
          "artistName": {
            "type": "string",
            "description": "The artist of the track"
          },
          "result": {
            "type": "string",
            "description": "The result of the guess",
            "enum": [
              "CORRECT",
              "ARTIST",
              "ALBUM",
              "WRONG",
              "SKIP",
              "ARTIST_AND_ALBUM"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "TrackOptionDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The ID of the track"
          },
          "name": {
            "type": "string",
            "description": "The name of the track"
          },
          "normalizedName": {
            "type": "string",
            "description": "Normalized name for search/matching"
          },
          "artist": {
            "type": "string",
            "description": "The artist of the track"
          },
          "normalizedArtist": {
            "type": "string",
            "description": "Normalized artist for search/matching"
          },
          "albumImageUrl": {
            "type": "string",
            "description": "The album image URL of the track"
          },
          "albumName": {
            "type": "string",
            "description": "The album name of the track"
          },
          "albumUrl": {
            "type": "string",
            "description": "The album URL of the track"
          },
          "releaseYear": {
            "type": "number",
            "description": "The release year of the track"
          }
        },
        "required": [
          "id",
          "name",
          "normalizedName",
          "artist",
          "normalizedArtist"
        ]
      },
      "MetaGameExtrasVo": {
        "type": "object",
        "properties": {
          "winEmoji": {
            "type": "string",
            "description": "Show this emoji on the win screen"
          }
        },
        "required": [
          "winEmoji"
        ]
      },
      "GameStateDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "description": "The ID of the game session"
          },
          "currentRound": {
            "type": "number",
            "description": "The current round of the game"
          },
          "snippetDuration": {
            "type": "number",
            "description": "The duration of the current snippet"
          },
          "status": {
            "type": "string",
            "description": "The status of the game",
            "enum": [
              "PLAYING",
              "WON",
              "LOST",
              "ABANDONED"
            ]
          },
          "guesses": {
            "description": "The guesses of the game",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuessHistoryDto"
            }
          },
          "previewUrl": {
            "type": "string",
            "description": "The preview URL of the current track"
          },
          "answer": {
            "description": "The answer to the current track",
            "allOf": [
              {
                "$ref": "#/components/schemas/TrackOptionDto"
              }
            ]
          },
          "rankTitle": {
            "type": "string",
            "description": "Optional personalized rank title (easter egg for special users)"
          },
          "specialNote": {
            "type": "string",
            "description": "Optional personalized note (easter egg for special users)"
          },
          "meta": {
            "description": "Optional win easter eggs",
            "allOf": [
              {
                "$ref": "#/components/schemas/MetaGameExtrasVo"
              }
            ]
          }
        },
        "required": [
          "sessionId",
          "currentRound",
          "snippetDuration",
          "status",
          "guesses",
          "previewUrl"
        ]
      },
      "GameHistoryEntryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Game session ID"
          },
          "date": {
            "type": "string",
            "description": "Date (YYYY-MM-DD) from completedAt or createdAt"
          },
          "status": {
            "type": "string",
            "description": "Game status",
            "enum": [
              "PLAYING",
              "WON",
              "LOST",
              "ABANDONED"
            ]
          },
          "score": {
            "type": "number",
            "description": "Score 0-6, may be null if abandoned"
          },
          "mode": {
            "type": "string",
            "description": "The game mode",
            "enum": [
              "DAILY",
              "ALL"
            ]
          },
          "guesses": {
            "description": "Guess history",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuessHistoryDto"
            }
          },
          "trackName": {
            "type": "string",
            "description": "Track name (answer)"
          },
          "artistName": {
            "type": "string",
            "description": "Artist name"
          },
          "albumImageUrl": {
            "type": "string",
            "description": "Album image URL"
          },
          "playlistName": {
            "type": "string",
            "description": "Playlist/source name e.g. Liked Songs"
          }
        },
        "required": [
          "id",
          "date",
          "status",
          "mode",
          "guesses",
          "trackName",
          "artistName"
        ]
      },
      "GameHistoryDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GameHistoryEntryDto"
            }
          },
          "total": {
