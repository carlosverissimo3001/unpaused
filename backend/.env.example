# Database
DATABASE_URL=''

# Redis
REDIS_URL=''

# Spotify OAuth
SPOTIFY_CLIENT_ID=''
SPOTIFY_REDIRECT_URI=''

# Session and Auth
SESSION_SECRET=''
SESSION_MAX_AGE_SECONDS=''
TOKEN_ENCRYPTION_KEY='' # 64 chars hex string (32 bytes) for AES-256 encryption

# CORS
# Origins allowed to call the public /demo endpoints, comma separated.
# These get CORS without credentials; leaving it unset blocks the portfolio.
PORTFOLIO_URL=

FRONTEND_URL=''

# Third-party API keys
LAST_FM_API_KEY=''
CLOUDINARY_URL=''
# Unset RESEND_API_KEY and mail is written to the log instead of sent.
# EMAIL_FROM must be at a domain verified in Resend; a subdomain keeps a
# deliverability problem here away from the root domain's reputation.
RESEND_API_KEY=''
EMAIL_FROM='' # e.g. unpaused <no-reply@unpaused.example.com>