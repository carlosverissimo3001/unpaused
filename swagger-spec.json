              "enum": [
                "DAILY",
                "ALL"
              ],
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "The limit of the history",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "description": "The offset of the history",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GameHistoryDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Get user's game session history (paginated)",
        "tags": [
          "Api"
        ]
      }
    },
    "/game/stats": {
      "get": {
        "operationId": "GameController_getStats",
        "parameters": [
          {
            "name": "mode",
            "required": true,
            "in": "query",
            "description": "The game mode",
            "schema": {
              "enum": [
                "DAILY",
