{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["src/*"],
      "@auth/*": ["src/auth/*"],
      "@redis/*": ["src/redis/*"],
      "@prisma/*": ["src/prisma/*"],
      "@transaction/*": ["src/transaction/*"],
      "@playlists/*": ["src/playlist/*"],
      "@game/*": ["src/game/*"],
      "@spotify/*": ["src/spotify/*"],
      "@tracks/*": ["src/track/*"],
      "@utils/*": ["src/utils/*"],
      "@throttle/*": ["src/throttle/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
