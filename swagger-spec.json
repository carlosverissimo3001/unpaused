    },
    "/game/{id}/guess": {
      "post": {
        "operationId": "GameController_submitGuess",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "The internal Game Session UUID",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
