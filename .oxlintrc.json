{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Deliberately close to the ESLint setup this replaced. Enabling oxlint's
  // other plugins (unicorn, jsx-a11y, promise, import) raises the findings from
  // 2 to 101 — that is a policy change, not a migration, so it is left for later.
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/out/**",
    "**/.turbo/**",
    "frontend/sdk/**",
    "backend/prisma/migrations/**",
    "**/next-env.d.ts"
  ],
  "rules": {
    "no-unused-vars": "off",
    "typescript/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "typescript/no-explicit-any": "warn",
    // Type-aware, so it only runs where the package passes --type-aware.
    "typescript/no-floating-promises": "error",
    // Both are type-aware rules ESLint never ran here. 27 findings between
    // them, worth their own pass rather than riding along with the migration.
    "typescript/no-misused-spread": "off",
    "typescript/unbound-method": "off"
  },
  "overrides": [
    {
      "files": ["frontend/**/*.{ts,tsx,js,jsx}"],
      "plugins": ["typescript", "react", "nextjs"],
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react-hooks/exhaustive-deps": "warn"
      }
    },
    {
      "files": ["backend/**/*.ts"],
      "plugins": ["typescript", "jest"]
    },
    {
      // ESLint ignored spec files entirely, so these were never linted. They
      // are now, minus the assertions that make `any` unavoidable in mocks.
      "files": ["**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-assignment": "off"
      }
    }
  ]
}
